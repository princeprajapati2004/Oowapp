# Both PostgreSQL and MySQL/MariaDB are supported — the engine is picked
# automatically from this URL's scheme (postgres:// / postgresql:// vs
# mysql:// / mariadb://) by scripts/select-db-provider.mjs, which runs
# before every prisma/build command (npm run predb). Nothing else needs to
# change to switch databases.

# PostgreSQL connection string (Neon, Supabase, Railway, or local)
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# MySQL / MariaDB connection string instead, e.g.:
# DATABASE_URL="mysql://user:password@host:3306/dbname"
# DATABASE_URL="mysql://user:password@localhost/dbname?socket=/run/mysqld/mysqld.sock"
#
# Note: `npm run build` uses `prisma migrate deploy` for Postgres (real
# migration history in prisma/migrations) but `prisma db push` for MySQL,
# since that migration history is Postgres SQL and has no MySQL equivalent
# yet — db push syncs the schema directly instead.

# Optional: shadow database used by `prisma migrate dev` to detect drift and
# generate new migrations locally. NOT required for `prisma migrate deploy`
# (production) or for anything the app does at runtime.
#
# Tested against this project's hosted "Prisma Postgres" connection
# (pooled.db.prisma.io): pointing shadowDatabaseUrl at a second *schema* in
# the same database (e.g. `&schema=shadow`) does NOT work reliably — the
# schema engine's cross-schema diff gets confused and reports a misleading
# "reset needed" warning even when nothing is actually wrong. Use a genuinely
# separate database instead (a second Neon/Supabase/Railway/local Postgres
# instance, or a second database on the same provider), e.g.:
# SHADOW_DATABASE_URL="postgresql://user:password@host:5432/shadow_dbname"

# Random secret used to sign admin session JWTs — generate with `openssl rand -base64 32`
JWT_SECRET="replace-with-a-long-random-secret"

# Separate secret for super-admin sessions — keep distinct from the other three
SA_JWT_SECRET="replace-with-a-different-long-random-secret-for-super-admin"

# Separate secret for customer account sessions — keep distinct from JWT_SECRET
CUSTOMER_JWT_SECRET="replace-with-a-different-long-random-secret"

# Separate secret for staff account sessions — keep distinct from the other three
STAFF_JWT_SECRET="replace-with-a-different-long-random-secret-for-staff"

# Web Push / VAPID keys — generate with: npx web-push generate-vapid-keys
# Then add NEXT_PUBLIC_VAPID_PUBLIC_KEY to your deployment environment.
VAPID_SUBJECT="mailto:admin@yourdomain.com"
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""

# Optional: SMS provider for checkout phone OTP verification (Customer
# Ordering module — only used by shops with "Require phone number" on in
# Settings). Leave SMS_PROVIDER unset to run in dev mode, where the code is
# only logged server-side ("[DEV OTP] ...") and never actually texted —
# nothing here is required to run the app locally.
#
# SMS_PROVIDER="twilio"
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_FROM_NUMBER=""
#
# SMS_PROVIDER="msg91"
# MSG91_AUTH_KEY=""
# MSG91_TEMPLATE_ID=""
#
# See src/lib/services/sms-provider.ts to wire up the adapter once you have one.

# Alternative to the SMS_PROVIDER adapters above: Firebase Phone Auth sends
# and verifies the OTP directly from the browser via the Firebase SDK (no
# server-side SMS adapter needed). When these are set, checkout's phone
# verification uses Firebase instead of the DB-backed OTP flow above. Get
# these from Firebase Console > Project Settings > General > Your apps (Web
# app config) — they're the public web SDK config, safe to expose client-side.
# Also requires enabling the "Phone" sign-in provider in
# Firebase Console > Authentication > Sign-in method.
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=""

# Vercel Blob storage token — Vercel dashboard -> Storage -> Blob -> create token
BLOB_READ_WRITE_TOKEN=""

# Public base URL of the deployed app, used to build QR codes / order links
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"

# Cloudinary configuration — cloudinary.com dashboard -> Account Details
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Optional: seeds the initial super-admin account (scripts/seed-super-admin.ts)
SUPER_ADMIN_SEED_EMAIL=""
SUPER_ADMIN_SEED_PASSWORD=""

# SMTP credentials used to send admin verification / password-reset emails
NO_REPLY_EMAIL=""
NO_REPLY_EMAIL_PASSWORD=""
SMTP_HOST=""
SMTP_PORT="587"

