generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  shop         Shop?

  @@map("admins")
}

model Shop {
  id                     String                      @id @default(cuid())
  adminId                String                      @unique
  slug                   String                      @unique
  businessName           String
  businessType           BusinessType                @default(RESTAURANT)
  logoUrl                String?
  phone                  String?
  whatsappNumber         String
  address                String?
  gstNumber              String?
  currency               String                      @default("INR")
  ownerName              String?
  city                   String?
  state                  String?
  country                String?
  status                 ShopStatus                  @default(ACTIVE)
  lastLoginAt            DateTime?
  suspendedAt            DateTime?
  suspendedReason        String?
  deletedAt              DateTime?
  upiId                  String?
  acceptCash             Boolean                     @default(true)
  bankAccountName        String?
  bankAccountNumber      String?
  bankIfsc               String?
  bankName               String?
  paymentQrImageUrl      String?
  requireCustomerName    Boolean                     @default(true)
  requirePhone           Boolean                     @default(false)
  requireTableNumber     Boolean                     @default(true)
  requireDeliveryAddress Boolean                     @default(false)
  allowNotes             Boolean                     @default(true)
  saveOrdersToDb         Boolean                     @default(false)
  isPublished            Boolean                     @default(true)
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt
  enableTableQr          Boolean                     @default(false)
  tableNames             String?
  enableTableNumber      Boolean                     @default(true)
  notifyNewOrders        Boolean                     @default(true)
  notifyOrderUpdates     Boolean                     @default(true)
  orderMode              OrderMode                   @default(WHATSAPP)
  paymentDisplayName     String?
  featurePermissions     BusinessFeaturePermission[]
  categories             Category[]
  customers              Customer[]
  orders                 Order[]
  phoneOtps              PhoneOtp[]
  products               Product[]
  pushSubscriptions      PushSubscription[]
  admin                  Admin                       @relation(fields: [adminId], references: [id], onDelete: Cascade)
  staff_members          staff_members[]
  subscriptions          Subscription[]
  tableSessions          TableSession[]
  taxes                  Tax[]
  parties                Party[]
  partyPayments          PartyPayment[]

  @@map("shops")
}

model Customer {
  id            String         @id @default(cuid())
  shopId        String
  name          String
  phone         String
  passwordHash  String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  shop          Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  orders        Order[]
  tableSessions TableSession[]

  @@unique([shopId, phone])
  @@index([shopId])
  @@map("customers")
}

// Customers/suppliers ledger ("Parties") — distinct from Customer above,
// which is a login account for the storefront. A Party is a CRM/khata-book
// contact (due tracking, GST, credit limit) with no login. Orders are linked
// by phone-number match at query time (see lib/services/party.ts), the same
// join key the admin "customer directory" (/api/admin/customers) already
// uses — no FK on Order, to keep every order-creation path untouched.
model Party {
  id             String        @id @default(cuid())
  shopId         String
  shop           Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  type           PartyType     @default(CUSTOMER)
  name           String
  phone          String
  gstNumber      String?
  businessName   String?
  address        String?
  category       PartyCategory @default(GENERAL)
  openingBalance Decimal       @default(0) @db.Decimal(10, 2)
  creditLimit    Decimal?      @db.Decimal(10, 2)
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  payments PartyPayment[]

  @@unique([shopId, phone])
  // Safe on Postgres with an optional field: NULLs are distinct from each
  // other in a unique index, so multiple parties with no GST never collide —
  // enforcing that gstNumber is normalized to null (never "") happens in
  // lib/validation/party.ts, since an empty string IS a value to Postgres.
  @@unique([shopId, gstNumber])
  @@index([shopId])
  @@map("parties")
}

// A single logged cash movement against a Party's running balance — not tied
// to a specific Order. RECEIVED = money the shop took in from the party
// (paying down what they owe); PAID = money the shop gave out to the party
// (a supplier settlement, or a customer refund/advance). See
// lib/services/party.ts for how direction affects the outstanding balance.
model PartyPayment {
  id        String                @id @default(cuid())
  shopId    String
  shop      Shop                  @relation(fields: [shopId], references: [id], onDelete: Cascade)
  partyId   String
  party     Party                 @relation(fields: [partyId], references: [id], onDelete: Cascade)
  amount    Decimal               @db.Decimal(10, 2)
  method    PartyPaymentMethod    @default(CASH)
  direction PartyPaymentDirection
  note      String?
  createdBy String
  createdAt DateTime              @default(now())

  @@index([shopId])
  @@index([partyId])
  @@map("party_payments")
}

model Category {
  id        String    @id @default(cuid())
  shopId    String
  name      String
  sortOrder Int       @default(0)
  isVisible Boolean   @default(true)
  createdBy String?
  updatedBy String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  shop      Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  products  Product[]
  taxes     Tax[]

  @@index([shopId])
  @@map("categories")
}

model Product {
  id          String      @id @default(cuid())
  shopId      String
  categoryId  String
  name        String
  description String?
  price       Decimal     @db.Decimal(10, 2)
  imageUrl    String?
  unit        String?
  foodType    FoodType    @default(NA)
  isAvailable Boolean     @default(true)
  isVisible   Boolean     @default(true)
  stock       Int?
  sortOrder   Int         @default(0)
  createdBy   String?
  updatedBy   String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  orderItems  OrderItem[]
  category    Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  shop        Shop        @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@index([categoryId])
  @@map("products")
}

model Tax {
  id         String       @id @default(cuid())
  shopId     String
  name       String
  type       TaxType      @default(PERCENTAGE)
  value      Decimal      @db.Decimal(10, 2)
  appliesTo  TaxAppliesTo @default(ENTIRE_BILL)
  categoryId String?
  isEnabled  Boolean      @default(true)
  sortOrder  Int          @default(0)
  createdBy  String?
  updatedBy  String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  category   Category?    @relation(fields: [categoryId], references: [id])
  shop       Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@map("taxes")
}

model Order {
  id                 String         @id @default(cuid())
  shopId             String
  billNumber         String
  customerName       String?
  customerPhone      String?
  tableNumber        String?
  deliveryAddress    String?
  notes              String?
  subtotal           Decimal        @db.Decimal(10, 2)
  taxTotal           Decimal        @db.Decimal(10, 2)
  grandTotal         Decimal        @db.Decimal(10, 2)
  taxBreakdown       Json
  createdAt          DateTime       @default(now())
  status             OrderStatus    @default(PENDING)
  discountReason     String?
  discountType       String?
  discountValue      Decimal?       @db.Decimal(10, 2)
  discountedTotal    Decimal?       @db.Decimal(10, 2)
  paymentMethod      String?
  source             String         @default("qr")
  customerId         String?
  clientRequestId    String?
  tableSessionId     String?
  priorityFlag       String?
  paymentConfirmedAt DateTime?
  paymentConfirmedBy String?
  paymentStatus      PaymentStatus  @default(PENDING)
  staffId            String?
  // Per-shop-per-day sequential display number, set only for admin-created
  // manual orders (see POST /api/admin/orders) — null for QR/WhatsApp orders.
  tokenNumber        Int?
  items              OrderItem[]
  customer           Customer?      @relation(fields: [customerId], references: [id])
  shop               Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  staff_members      staff_members? @relation(fields: [staffId], references: [id])
  tableSession       TableSession?  @relation(fields: [tableSessionId], references: [id])

  @@unique([shopId, clientRequestId])
  @@index([shopId])
  @@index([customerId])
  @@index([tableSessionId])
  @@index([shopId, customerPhone])
  @@map("orders")
}

model TableSession {
  id              String             @id @default(cuid())
  shopId          String
  tableNumber     String
  status          TableSessionStatus @default(ACTIVE)
  customerName    String?
  customerPhone   String?
  customerId      String?
  billRequestedAt DateTime?
  paymentMethod   String?
  paymentNote     String?
  paidAt          DateTime?
  paidBy          String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  orders          Order[]
  customer        Customer?          @relation(fields: [customerId], references: [id])
  shop            Shop               @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@index([shopId, tableNumber])
  @@map("table_sessions")
}

model PhoneOtp {
  id         String    @id @default(cuid())
  shopId     String
  phone      String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
  shop       Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, phone])
  @@map("phone_otps")
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  productId String?
  name      String
  price     Decimal  @db.Decimal(10, 2)
  quantity  Int
  lineTotal Decimal  @db.Decimal(10, 2)
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

model SuperAdmin {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("super_admins")
}

model Subscription {
  id        String                 @id @default(cuid())
  shopId    String
  plan      SubscriptionPlan       @default(FREE)
  status    SubscriptionStatus     @default(TRIAL)
  startDate DateTime               @default(now())
  endDate   DateTime?
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
  planId    String?
  duration  SubscriptionDuration   @default(ONE_MONTH)
  action    SubscriptionActionType @default(CREATED)
  createdBy String?
  remarks   String?
  planRef   Plan?                  @relation(fields: [planId], references: [id])
  shop      Shop                   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@index([shopId, createdAt])
  @@map("subscriptions")
}

model Plan {
  id            String         @id @default(cuid())
  code          String         @unique
  name          String
  description   String?
  isActive      Boolean        @default(true)
  sortOrder     Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  planFeatures  PlanFeature[]
  subscriptions Subscription[]

  @@map("plans")
}

model Feature {
  id                String                      @id @default(cuid())
  key               String                      @unique
  label             String
  description       String?
  category          String?
  isActive          Boolean                     @default(true)
  createdAt         DateTime                    @default(now())
  businessOverrides BusinessFeaturePermission[]
  planFeatures      PlanFeature[]

  @@map("features")
}

model PlanFeature {
  id        String  @id @default(cuid())
  planId    String
  featureId String
  enabled   Boolean @default(true)
  feature   Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)
  plan      Plan    @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, featureId])
  @@map("plan_features")
}

model BusinessFeaturePermission {
  id        String   @id @default(cuid())
  shopId    String
  featureId String
  enabled   Boolean
  reason    String?
  updatedBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  feature   Feature  @relation(fields: [featureId], references: [id], onDelete: Cascade)
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, featureId])
  @@index([shopId])
  @@map("business_feature_permissions")
}

model AuditLog {
  id         String      @id @default(cuid())
  action     AuditAction
  actorType  String
  actorId    String
  targetType String?
  targetId   String?
  metadata   Json?
  shopId     String?
  ipAddress  String?
  userAgent  String?
  requestId  String?
  createdAt  DateTime    @default(now())

  @@index([shopId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}

model PlatformSettings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt

  @@map("platform_settings")
}

model PushSubscription {
  id        String   @id @default(cuid())
  shopId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@map("push_subscriptions")
}

model staff_members {
  id           String    @id
  shopId       String
  name         String
  email        String?
  phone        String?
  role         StaffRole
  passwordHash String
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime
  orders       Order[]
  shops        Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, email])
  @@index([shopId])
}

enum BusinessType {
  RESTAURANT
  CAFE
  BAKERY
  GROCERY
  MEDICAL
  ELECTRONICS
  CLOTHING
  STORE
  OTHER
}

enum FoodType {
  VEG
  NON_VEG
  NA
}

enum TaxType {
  PERCENTAGE
  FIXED
}

enum TaxAppliesTo {
  ENTIRE_BILL
  CATEGORY
}

enum ShopStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
  DELETED
}

enum SubscriptionPlan {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  EXPIRED
  CANCELLED
  SUSPENDED
}

enum SubscriptionDuration {
  FIFTEEN_DAYS
  ONE_MONTH
  THREE_MONTHS
  SIX_MONTHS
  TWELVE_MONTHS
  CUSTOM
}

enum SubscriptionActionType {
  CREATED
  RENEWED
  EXTENDED
  PLAN_CHANGED
  SUSPENDED
  RESUMED
  EXPIRED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum TableSessionStatus {
  ACTIVE
  AWAITING_PAYMENT
  PAID
}

enum AuditAction {
  ADMIN_SIGNUP
  ADMIN_LOGIN
  ADMIN_LOGOUT
  SUPER_ADMIN_LOGIN
  SUPER_ADMIN_LOGOUT
  SHOP_UPDATED
  SHOP_SUSPENDED
  SHOP_ACTIVATED
  SHOP_DELETED
  CATEGORY_CREATED
  CATEGORY_UPDATED
  CATEGORY_DELETED
  PRODUCT_CREATED
  PRODUCT_UPDATED
  PRODUCT_DELETED
  TAX_CREATED
  TAX_UPDATED
  TAX_DELETED
  ORDER_CREATED
  PLATFORM_SETTINGS_UPDATED
  SUBSCRIPTION_CHANGED
  TABLE_SESSION_MARKED_PAID
  ORDER_MARKED_PAID
}

enum OrderMode {
  WHATSAPP
  DIRECT
}

enum PaymentStatus {
  PENDING
  PAID
}

enum StaffRole {
  MANAGER
  KITCHEN
  WAITER
}

enum PartyType {
  CUSTOMER
  SUPPLIER
}

enum PartyCategory {
  VIP
  WHOLESALE
  RETAIL
  GENERAL
}

enum PartyPaymentMethod {
  CASH
  UPI
  CARD
  BANK_TRANSFER
  OTHER
}

enum PartyPaymentDirection {
  RECEIVED
  PAID
}
